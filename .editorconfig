root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
# Prose/statements wrap at 120; declarations and function signatures may run to ~240
# rather than wrap. Editors enforce only the hard limit below.
max_line_length = 120

[*.{cpp,hpp,h}]
max_line_length = 240

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.md]
max_line_length = off

[Makefile]
indent_style = tab
